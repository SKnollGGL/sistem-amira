# ============================================
# AMIRA LOCAL BOT - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in values

# SERVER CONFIGURATION
PORT=3001
NODE_ENV=development

# CLAUDE API (Individual Account - New Key)
CLAUDE_API_KEY=sk-ant-[PLACEHOLDER_YOUR_CLAUDE_API_KEY_HERE]
CLAUDE_MODEL=claude-opus-4-1-20250805

# SUPABASE (Optional - for logging conversations)
SUPABASE_URL=https://[PLACEHOLDER_YOUR_SUPABASE_PROJECT_ID].supabase.co
SUPABASE_KEY=[PLACEHOLDER_YOUR_SUPABASE_JWT_TOKEN_HERE]

# API CONFIGURATION
API_URL=http://localhost:3001
